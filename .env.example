# Optional local shell overrides for the protein training and ablation scripts.
#
# Usage:
#   cp .env.example .env.protein
#   set -a
#   source .env.protein
#   set +a
#
# No secrets are required by default for public model and dataset access.
# These values are conservative SHORT-RUN (ablation) defaults.
# The overnight script (run_overnight_4gpu_hardneg_dms.sh) has its own
# built-in defaults (e.g. MAX_MINUTES=720, MAX_MAP_ROWS=70000000).

CUDA_VISIBLE_DEVICES=0
WANDB_MODE=offline
WANDB_PROJECT=protein

# ── Model and naming ──
BASE_MODEL=facebook/esm2_t12_35M_UR50D
RUN_PREFIX=ablation_v2_stagewise

# ── Data paths ──
PFAM_FILE=data/pfam_sorted.parquet
AFDB_FILE=data/afdb_sorted.parquet
STRINGDB_FILE=data/stringdb/stringdb_train.parquet
DMS_COSENT_FILE=data/dms_cosent.parquet
HARD_NEG_PARQUET=data/pfam_hard_negatives.parquet

# ── Training (ablation / short-run defaults) ──
GPU_IDS=0
NUM_PROCESSES=1
MIXED_PRECISION=bf16
MAX_MINUTES=30
MAX_MAP_ROWS=1500000
BATCH_SIZE=64
GRAD_ACCUM=2
MNRL_MINI_BATCH=32
LEARNING_RATE=1e-4
WARMUP_STEPS=1000

# ── Benchmark ──
BENCH_FAST=true
BENCH_GPU=0
CACHE_EMBEDDINGS=false