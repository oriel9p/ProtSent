{
  "experiment": "ProtSent late-interaction pilot (35M)",
  "branch": "LateInteractions",
  "base_public_commit": "0c6ead8 (fix/train-max-seq-length-and-gor)",
  "arms": {
    "esm2_dense": {"model": "Synthyra/ESM2-35M", "scoring": "pooled cosine"},
    "protsent_v2_dense": {"model": "GrimSqueaker/ProtSent-V2-35M", "scoring": "pooled cosine"},
    "esm2_zeroshot": {"model": "Synthyra/ESM2-35M", "scoring": "MaxSim over native 480-D residue states"},
    "protsent_v2_zeroshot": {"model": "GrimSqueaker/ProtSent-V2-35M", "scoring": "MaxSim over native 480-D residue states"},
    "esm2_late": {"init": "Synthyra/ESM2-35M", "training": "late-interaction contrastive continuation"},
    "protsent_late": {"init": "GrimSqueaker/ProtSent-V2-35M", "training": "late-interaction contrastive continuation"}
  },
  "late_head": {"projection_dim": 64, "mask": "<cls>/<eos> skiplisted on query and document", "normalize": "per-residue L2"},
  "training": {
    "loss": "CachedMultiVectorMultipleNegativesRankingLoss (scale 1.0, MaxSim)",
    "data": "/storage/users/ddofer/data/protsent-data-dc40/{pfam_sorted,afdb_sorted,stringdb_train_15M}.parquet",
    "sampler": "ROUND_ROBIN over the three sources; no DMS, hard negatives, GOR or Matryoshka",
    "max_seq_length": 512,
    "lr_backbone": 1e-05,
    "lr_projection": 0.0001,
    "warmup_steps": 100,
    "target_steps": "min(2500, what fits in 2h45m)",
    "seed": 42
  },
  "evaluation": {
    "scope40": "exact all-vs-all, fold/superfamily/family, eligible-query metrics, bootstrap_ci.per_query_metrics",
    "pooled": "ProtBench --fast --eval_split test -p knn --knn_k 3 --seed 42 on dense views (linear separately)",
    "protbench_branch": "scope-hierarchy @ /opt/hpc/ddofer/ProtBench"
  },
  "environment": {
    "sentence_transformers": "6.0.0",
    "torch": "2.13.0+cu130",
    "transformers": "5.14.1",
    "python": "3.13.12",
    "gpus": "4x NVIDIA A100-SXM4-80GB"
  }
}
